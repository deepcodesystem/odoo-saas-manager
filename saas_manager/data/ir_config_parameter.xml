<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Base domain for SaaS instances -->
        <record id="saas_base_domain" model="ir.config_parameter">
            <field name="key">saas.base_domain</field>
            <field name="value">example.com</field>
        </record>

        <!-- Odoo host for provisioning -->
        <record id="saas_odoo_host" model="ir.config_parameter">
            <field name="key">saas.odoo_host</field>
            <field name="value">localhost</field>
        </record>

        <!-- Odoo port for provisioning -->
        <record id="saas_odoo_port" model="ir.config_parameter">
            <field name="key">saas.odoo_port</field>
            <field name="value">8069</field>
        </record>

        <!-- SSL verification for RPC calls to instances -->
        <record id="saas_verify_ssl" model="ir.config_parameter">
            <field name="key">saas.verify_ssl</field>
            <field name="value">True</field>
        </record>

        <!-- Neutralization scope on cloned instances: none | light -->
        <record id="saas_neutralize_scope" model="ir.config_parameter">
            <field name="key">saas.neutralize_scope</field>
            <field name="value">light</field>
        </record>

        <!-- User limit alert thresholds (percent) -->
        <record id="saas_user_limit_warn_percent" model="ir.config_parameter">
            <field name="key">saas.user_limit_warn_percent</field>
            <field name="value">80</field>
        </record>
        <record id="saas_user_limit_alert_percent" model="ir.config_parameter">
            <field name="key">saas.user_limit_alert_percent</field>
            <field name="value">95</field>
        </record>

    </data>
</odoo>
